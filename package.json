        "@types/node": "^22",
        "@types/react": "^19.2.18",
        "@types/react-color": "^3.0.7",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.2",
        "@vitest/coverage-v8": "^4.1.6",
        "jsdom": "^29.1.1",
        "typescript": "^6.0.0",
        "vite": "^8.0.13",
        "vitest": "^4.1.6"
    }
