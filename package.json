        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.3",
        "@yudiel/react-qr-scanner": "^2.6.0",
        "antd": "^5.8.4",
        "dayjs": "^1.11.9",
        "dotenv": "^16.3.1",
        "eventemitter3": "^5.0.1",
        "file-saver": "^2.0.5",
        "handlebars": "^4.7.8",
        "jwt-decode": "^3.1.2",
        "koa": "^2.14.2",
        "koa-compress": "^5.1.1",
        "koa-proxies": "^0.12.3",
        "koa-static": "^5.0.0",
        "nanoid": "^4.0.2",
