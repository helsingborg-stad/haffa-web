    "compilerOptions": {
        "strict": true,
        "module": "NodeNext",
        "target": "ES2022",
        "rootDir": "./src",
        "outDir": "./build",
        "moduleResolution": "NodeNext",
        "esModuleInterop": true,
        "resolveJsonModule": true
    },
    "include": ["src/**/*"]
}
